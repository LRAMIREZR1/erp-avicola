NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# Solo para el servidor (Server Actions) — NUNCA lleva el prefijo NEXT_PUBLIC_.
# Se usa para crear usuarios nuevos desde /admin/usuarios (Admin API de
# Supabase). Se obtiene en Supabase → Project Settings → API → "service_role"
# (secret). Es la misma key que usa .github/scripts/sugerencia-precios.mjs.
SUPABASE_SERVICE_KEY=tu-service-role-key
